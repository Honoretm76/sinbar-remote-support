# Copy to /etc/sinbar/support-deployment.env, replace every value, then set
# root:root mode 0600. This file contains public trust pins but is privileged
# configuration because it controls what production is permitted to run.

# Immutable image built from server/ and reviewed before deployment.
SUPPORT_API_IMAGE=registry.example.invalid/sinbar/support-session-api@sha256:REPLACE_WITH_64_LOWERCASE_HEX
REVIEWED_SOURCE_COMMIT=REPLACE_WITH_FULL_40_CHARACTER_GIT_COMMIT

# Dedicated, non-overlapping private Docker network. The API trusts only the
# portal's exact address as a forwarding proxy.
SUPPORT_SESSION_SUBNET=172.31.250.0/28
SUPPORT_PORTAL_SESSION_IP=172.31.250.2
SUPPORT_API_SESSION_IP=172.31.250.3

# Exact current IPv4 address of sinbar-noc-cloudflared on the Docker network
# used to reach this portal. Use /32 unless that container has a reviewed,
# dedicated small subnet. Preflight confirms the container is running at this
# address; broad RFC1918 ranges are rejected.
CLOUDFLARED_CONTAINER=sinbar-noc-cloudflared
CLOUDFLARED_NETWORK=REPLACE_WITH_EXACT_DOCKER_NETWORK_NAME
CLOUDFLARED_PROXY_CIDR=172.31.251.4/32

# These two values must be compiled into both signed assistants. The public
# point is the unpadded base64url form of 65-byte P-256 X9.63 04||X||Y.
MANIFEST_KEY_ID=sinbar-support-manifest-p256-v1
MANIFEST_P256_PUBLIC_KEY_X963_BASE64URL=REPLACE_WITH_87_CHARACTER_PUBLIC_PIN

# Native signing identities, verified by the platform verification scripts.
WINDOWS_SIGNER_CERT_SHA256=REPLACE_WITH_64_LOWERCASE_CERTIFICATE_FINGERPRINT
WINDOWS_SIGNER_SUBJECT=Sinbar Consultants LLC
APPLE_INSTALLER_TEAM_ID=REPLACE10

# Must be extracted from, and identical on, both approved RustDesk 1.4.9 DMGs.
RUSTDESK_MACOS_TEAM_IDENTIFIER=REPLACE10
