    "${LIVE_ROOT}/download/vendor/rustdesk/${RUSTDESK_VERSION}/macos"

# Install payloads and support assets first. Publish index.html last.
atomic_install "${STAGE_SITE}/download/vendor/rustdesk/${RUSTDESK_VERSION}/windows/${WIN_X64_FILE}" \
    "${LIVE_ROOT}/download/vendor/rustdesk/${RUSTDESK_VERSION}/windows/${WIN_X64_FILE}"
atomic_install "${STAGE_SITE}/download/vendor/rustdesk/${RUSTDESK_VERSION}/windows/${WIN_ARM64_FILE}" \
    "${LIVE_ROOT}/download/vendor/rustdesk/${RUSTDESK_VERSION}/windows/${WIN_ARM64_FILE}"
atomic_install "${STAGE_SITE}/download/vendor/rustdesk/${RUSTDESK_VERSION}/macos/${MAC_X64_FILE}" \
    "${LIVE_ROOT}/download/vendor/rustdesk/${RUSTDESK_VERSION}/macos/${MAC_X64_FILE}"
atomic_install "${STAGE_SITE}/download/vendor/rustdesk/${RUSTDESK_VERSION}/macos/${MAC_ARM64_FILE}" \
    "${LIVE_ROOT}/download/vendor/rustdesk/${RUSTDESK_VERSION}/macos/${MAC_ARM64_FILE}"
atomic_install "${STAGE_SITE}/download/SHA256SUMS.txt" "${LIVE_ROOT}/download/SHA256SUMS.txt"
atomic_install "${STAGE_SITE}/download/manifest.json" "${LIVE_ROOT}/download/manifest.json"
atomic_install "${STAGE_SITE}/assets/sinbar-primary-logo.jpg" "${LIVE_ROOT}/assets/sinbar-primary-logo.jpg"
atomic_install "${STAGE_SITE}/assets/styles.css" "${LIVE_ROOT}/assets/styles.css"
atomic_install "${STAGE_SITE}/assets/app.js" "${LIVE_ROOT}/assets/app.js"

# nginx.conf is a direct file bind mount. Overwrite the existing inode so the
# running container sees the new bytes before nginx -t; do not replace it by mv.
install -o root -g root -m 0644 "${REPO_ROOT}/deploy/nginx.conf" "${WORK_ROOT}/nginx.conf"
cp --preserve=mode,ownership,timestamps -- "${WORK_ROOT}/nginx.conf" "$NGINX_CONFIG"

docker exec "$CONTAINER" nginx -t
atomic_install "${STAGE_SITE}/index.html" "${LIVE_ROOT}/index.html"
docker exec "$CONTAINER" nginx -s reload

for attempt in $(seq 1 30); do
    if curl --max-time 5 --silent --show-error --fail "${LOCAL_BASE}/health" >/dev/null; then
        break
    fi
    (( attempt < 30 )) || die "Portal health endpoint did not recover after Nginx reload"
    sleep 2
done

verify_portal_endpoint "$LOCAL_BASE" "local"
verify_portal_endpoint "$PUBLIC_BASE" "public"

# Confirm the exact live source files still match what was reviewed.
[[ "$(sha256_of "${LIVE_ROOT}/index.html")" == "$PORTAL_INDEX_SHA256" ]] || die "Live index.html drifted"
[[ "$(sha256_of "${LIVE_ROOT}/assets/app.js")" == "$PORTAL_APP_SHA256" ]] || die "Live app.js drifted"
[[ "$(sha256_of "${LIVE_ROOT}/assets/styles.css")" == "$PORTAL_CSS_SHA256" ]] || die "Live styles.css drifted"
[[ "$(sha256_of "${LIVE_ROOT}/download/manifest.json")" == "$PORTAL_MANIFEST_SHA256" ]] || die "Live manifest drifted"
[[ "$(sha256_of "$NGINX_CONFIG")" == "$PORTAL_NGINX_SHA256" ]] || die "Live Nginx configuration drifted"

DEPLOY_COMPLETE=1

log PASS "Sinbar Remote Support portal v2.1.0 deployed and fully verified"
log INFO "Public portal: ${PUBLIC_BASE}/"
log INFO "Rollback backup: ${BACKUP_ARCHIVE}"
log INFO "No private GitHub token, signing key, permanent password, or unattended-access credential was used"
