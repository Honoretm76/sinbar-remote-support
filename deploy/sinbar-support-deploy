    check_text_route "$base" "/assets/app.js" "application/javascript" "$scope portal application"
    check_text_route "$base" "/download/manifest.json" "application/json" "$scope release manifest"
    check_text_route "$base" "/download/SHA256SUMS.txt" "text/plain" "$scope checksum manifest"

    verify_download_route "$base" "/download/windows/x64" \
        "application/vnd.microsoft.portable-executable" "$WINDOWS_X64_DOWNLOAD_NAME" \
        "$WIN_X64_BYTES" "$WIN_X64_SHA256" "$scope-Windows-x64"

