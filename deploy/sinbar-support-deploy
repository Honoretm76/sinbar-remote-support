}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"
}

sha256_of() {
    sha256sum -- "$1" | awk '{print $1}'
}

verify_file() {
    local path="$1"
    local expected_bytes="$2"
    local expected_sha256="$3"
    local label="$4"
    local actual_bytes actual_sha256

    [[ -f "$path" && ! -L "$path" ]] || die "$label is missing or is not a regular file: $path"

    actual_bytes="$(stat -c '%s' -- "$path")"
    [[ "$actual_bytes" == "$expected_bytes" ]] ||
        die "$label byte-count mismatch: expected $expected_bytes, got $actual_bytes"

    actual_sha256="$(sha256_of "$path")"
    [[ "$actual_sha256" == "$expected_sha256" ]] ||
        die "$label SHA-256 mismatch: expected $expected_sha256, got $actual_sha256"

    log PASS "$label verified (${actual_bytes} bytes; SHA-256 ${actual_sha256})"
}

verify_source_file() {
    local relative_path="$1"
    local expected_sha256="$2"
    local label="$3"
    local path="${REPO_ROOT}/${relative_path}"
    local actual_sha256

    [[ -f "$path" && ! -L "$path" ]] || die "$label is missing: $path"
    actual_sha256="$(sha256_of "$path")"
    [[ "$actual_sha256" == "$expected_sha256" ]] ||
        die "$label does not match the reviewed PR #1 content (got $actual_sha256)"

    log PASS "$label matches the reviewed source"
}

download_official() {
    local url="$1"
    local destination="$2"
    local expected_bytes="$3"
    local expected_sha256="$4"
    local label="$5"
    local temporary="${destination}.partial"

    rm -f -- "$temporary"
    log INFO "Downloading $label from the official RustDesk release"

    curl \
        --fail \
        --location \
        --proto '=https' \
        --proto-redir '=https' \
        --tlsv1.2 \
        --connect-timeout 20 \
        --max-time 1200 \
        --retry 4 \
        --retry-delay 2 \
        --retry-all-errors \
        --output "$temporary" \
        "$url"

    verify_file "$temporary" "$expected_bytes" "$expected_sha256" "$label"
    mv -f -- "$temporary" "$destination"
}

atomic_install() {
    local source="$1"
    local destination="$2"
    local temporary="${destination}.new.$$"

    install -o root -g root -m 0644 -- "$source" "$temporary"
    mv -f -- "$temporary" "$destination"
}

restore_backup() {
    local rollback_result=0
    local rollback_stage

    (( ROLLBACK_ACTIVE == 0 )) || return 0
    ROLLBACK_ACTIVE=1
    set +e

    log WARN "Deployment failed; restoring the pre-deployment portal and Nginx configuration"

    if [[ -f "$BACKUP_ARCHIVE" ]]; then
        rollback_stage="${WORK_ROOT}/rollback"
        rm -rf -- "$rollback_stage"
        install -d -m 0700 "$rollback_stage"
        tar -C "$rollback_stage" -xzf "$BACKUP_ARCHIVE" || rollback_result=1

        # These guards prevent a future edit from widening the destructive target.
        if [[ "$LIVE_ROOT" == "/opt/sinbar/apps/noc-support/support-portal/site" &&
              -d "$LIVE_ROOT" && ! -L "$LIVE_ROOT" ]]; then
            find "$LIVE_ROOT" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || rollback_result=1
            cp -a -- "$rollback_stage/support-portal/site/." "$LIVE_ROOT/" || rollback_result=1

            # nginx.conf is a direct file bind mount. Restore its bytes through
            # the existing inode so the running container sees the rollback.
            cp --preserve=mode,ownership,timestamps -- \
                "$rollback_stage/support-portal/nginx.conf" "$NGINX_CONFIG" || rollback_result=1
        else
            log ERROR "Rollback guard rejected unexpected live root: $LIVE_ROOT"
            rollback_result=1
        fi
    else
        log ERROR "Rollback archive is unavailable"
        rollback_result=1
    fi

    docker exec "$CONTAINER" nginx -t || rollback_result=1
    docker exec "$CONTAINER" nginx -s reload || rollback_result=1

    if (( rollback_result == 0 )); then
        log PASS "Rollback completed successfully"
    else
        log ERROR "Rollback encountered an error; use backup $BACKUP_ARCHIVE before further changes"
    fi

    return "$rollback_result"
}

cleanup_and_exit() {
    local rc=$?
    trap - EXIT INT TERM HUP

    if (( rc != 0 && DEPLOY_APPLIED == 1 && DEPLOY_COMPLETE == 0 )); then
        restore_backup || true
    fi

    if [[ -n "$WORK_ROOT" && -d "$WORK_ROOT" ]]; then
        rm -rf -- "$WORK_ROOT"
    fi

    exit "$rc"
}

check_text_route() {
    local base="$1"
    local path="$2"
    local expected_type="$3"
    local label="$4"
    local cache_bust="deploy=$(date -u +%s)"
    local result code content_type ssl_result url

    url="${base}${path}"
    if [[ "$base" == https://* ]]; then
        url="${url}?${cache_bust}"
    fi

    result="$(curl --max-time 30 --silent --show-error --location --output /dev/null \
        --write-out '%{http_code}|%{content_type}|%{ssl_verify_result}' "$url")"

    code="${result%%|*}"
    result="${result#*|}"
    content_type="${result%%|*}"
    ssl_result="${result##*|}"

    [[ "$code" == "200" ]] || die "$label returned HTTP $code"
    [[ "$content_type" == "$expected_type"* ]] ||
        die "$label returned unexpected content type: $content_type"

    if [[ "$base" == https://* ]]; then
        [[ "$ssl_result" == "0" ]] || die "$label failed TLS validation: $ssl_result"
    fi

    log PASS "$label returned HTTP 200 ($content_type)"
}

verify_download_route() {
    local base="$1"
    local path="$2"
    local expected_type="$3"
    local expected_name="$4"
    local expected_bytes="$5"
    local expected_sha256="$6"
    local label="$7"
    local safe_label headers body url code content_type content_disposition ssl_result

    safe_label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_')"
    headers="${VERIFY_ROOT}/${safe_label}.headers"
    body="${VERIFY_ROOT}/${safe_label}.body"
    url="${base}${path}"

    if [[ "$base" == https://* ]]; then
        url="${url}?deploy=$(date -u +%s%N)"
    fi

    curl \
        --fail \
        --location \
        --proto-redir '=https' \
        --connect-timeout 20 \
        --max-time 1200 \
        --retry 3 \
        --retry-delay 2 \
        --retry-all-errors \
        --dump-header "$headers" \
        --output "$body" \
        --write-out '%{http_code}|%{content_type}|%{ssl_verify_result}' \
        "$url" > "${headers}.result"

    IFS='|' read -r code content_type ssl_result < "${headers}.result"

    [[ "$code" == "200" ]] || die "$label returned HTTP $code"
    [[ "$content_type" == "$expected_type"* ]] ||
        die "$label returned unexpected content type: $content_type"

    content_disposition="$(awk 'BEGIN {IGNORECASE=1} /^Content-Disposition:/ {sub(/^[^:]*:[[:space:]]*/, ""); sub(/\r$/, ""); value=$0} END {print value}' "$headers")"
    [[ "$content_disposition" == *"filename=\"${expected_name}\""* ]] ||
        die "$label returned unexpected Content-Disposition: $content_disposition"

    if [[ "$base" == https://* ]]; then
        [[ "$ssl_result" == "0" ]] || die "$label failed TLS validation: $ssl_result"
    fi

    verify_file "$body" "$expected_bytes" "$expected_sha256" "$label response body"
    rm -f -- "$body" "$headers" "${headers}.result"
}

verify_portal_endpoint() {
