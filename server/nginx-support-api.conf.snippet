# Put limit_req_zone in the nginx http{} context (not inside server{}):
# limit_req_zone $binary_remote_addr zone=support_session_create:10m rate=10r/m;
# limit_req_zone $binary_remote_addr zone=support_session_consume:10m rate=30r/m;
#
# These locations belong in support.sinbarconsultants.com's server{} block.
# The API container must share a private Docker network with this Nginx service.

location = /api/v1/support/sessions {
    limit_except POST OPTIONS { deny all; }
    limit_req zone=support_session_create burst=3 nodelay;

    client_max_body_size 4k;
    proxy_pass http://support-session-api:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-ID $request_id;
    proxy_hide_header Server;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
}

location = /api/v1/support/sessions/consume {
    limit_except POST OPTIONS { deny all; }
    limit_req zone=support_session_consume burst=5 nodelay;

    # Never log this request body; it contains the 120-second bearer token.
    access_log off;
    client_max_body_size 4k;
    proxy_pass http://support-session-api:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-ID $request_id;
    proxy_hide_header Server;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
}

location = /api/v1/health {
    access_log off;
    proxy_pass http://support-session-api:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
}

