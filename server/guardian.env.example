# Copy to a root-owned mode-0600 environment file. Never commit its values.
SUPPORT_PUBLIC_ORIGIN=https://support.sinbarconsultants.com
DATABASE_PATH=/data/sessions.sqlite3
ARTIFACT_MANIFEST_PATH=/run/config/artifacts.json
MANIFEST_SIGNING_KEY_FILE=/run/secrets/support-manifest-p256.pem
MANIFEST_KEY_ID=sinbar-support-manifest-p256-v1

# Generate independently: openssl rand -base64 48
SESSION_HMAC_KEY_BASE64=REPLACE_WITH_BASE64_SECRET
AUDIT_HMAC_KEY_BASE64=REPLACE_WITH_DIFFERENT_BASE64_SECRET

# Configure the exact Docker subnet/address of the same-origin Nginx proxy.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

SESSION_TTL_SECONDS=120
MANIFEST_TTL_SECONDS=300
CREATE_RATE_LIMIT=10
CONSUME_RATE_LIMIT=30
RATE_WINDOW_SECONDS=60
MAX_BODY_BYTES=4096

# Replace every digest with the verified SHA-256 of the exact hosted artifact.
RUSTDESK_WINDOWS_X86_64_SHA256=c87d2f4cef2a5acd6003b6507dcfbf5d5168a256db082cd90b54d35193224aaa
RUSTDESK_WINDOWS_ARM64_SHA256=30bc8925e62c7ade52371758c2b944036ed2386f6c554e9e59f3bcfef06c7cd9
RUSTDESK_MACOS_X86_64_SHA256=fa1129a0635019f9c5841937942cc2b08be028a192f47c009edde7e53812904e
RUSTDESK_MACOS_ARM64_SHA256=f7935597b247d42c8f2a2ed71176a9f5868018cd9e1a33b8096418a668c8caf0
RUSTDESK_MACOS_TEAM_IDENTIFIER=REPLACE_WITH_VERIFIED_TEAM_ID
