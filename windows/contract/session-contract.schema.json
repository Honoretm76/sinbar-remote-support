{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support.sinbarconsultants.com/schemas/support-session-v1.json",
  "title": "Sinbar Support Session Contract v1",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "consumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "platform", "architecture", "assistantVersion"],
      "properties": {
        "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "platform": { "const": "windows" },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "assistantVersion": { "const": "2.0.0" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "payload", "signature"],
      "properties": {
        "keyId": { "const": "sinbar-support-manifest-p256-v1" },
        "payload": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sessionId",
        "action",
        "attended",
        "platform",
        "architecture",
        "issuedAt",
        "expiresAt",
        "artifact"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string", "format": "uuid" },
        "action": { "const": "ensure-and-launch-rustdesk" },
        "attended": { "const": true },
        "platform": { "const": "windows" },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "issuedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "sha256", "version", "publisherSubjectContains"],
          "properties": {
            "kind": { "const": "msi" },
            "url": {
              "enum": [
                "https://support.sinbarconsultants.com/download/vendor/rustdesk/1.4.9/windows/rustdesk-1.4.9-x86_64.msi",
                "https://support.sinbarconsultants.com/download/vendor/rustdesk/1.4.9/windows/rustdesk-1.4.9-aarch64.msi"
              ]
            },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "version": { "const": "1.4.9" },
            "publisherSubjectContains": { "const": "PURSLANE" }
          }
        }
      }
    }
  }
}
